# EAS Build Configuration
# Copy this to .env.local and fill in your values

# Get this from: eas project:init
EAS_PROJECT_ID=your-project-id-here

# iOS bundle identifier (reverse domain notation)
IOS_BUNDLE_ID=com.yourcompany.motionai

# Android package name (reverse domain notation)
ANDROID_PACKAGE=com.yourcompany.motionai
